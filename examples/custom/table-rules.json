      "mapping": {
        "Код": "item",
        "Описание": "label",
        "Сумма": "amount",
        "Город": "city"
      },
      "encoding": "utf-8"
    },
    {
      "name": "orders-two.csv",
      "delimiter": "auto",
      "header_row": 1,
      "mapping": {
        "Код": "code",
        "Описание": "title",
        "Сумма": "total",
        "Город": "town"
      },
      "encoding": "windows-1251"
    }
  ]
